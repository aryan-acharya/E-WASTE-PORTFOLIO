rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /assignments/{assignmentId} {
      // Anyone can view/read published assignments; authorized admin can read all (including drafts)
      allow read: if resource.data.isPublished == true || 
        (request.auth != null && 
         (request.auth.token.email == 'aryanacharya0211@gmail.com' || 
          request.auth.token.email == 'aryanacharya211@gmail.com' ||
          (request.auth.token.email != null && request.auth.token.email.matches('^aryanacharya.*@gmail[.]com$'))));

      // Only the verified admin Google account is authorized to create, update, or delete
      allow create, update, delete: if request.auth != null && 
        (request.auth.token.email == 'aryanacharya0211@gmail.com' || 
         request.auth.token.email == 'aryanacharya211@gmail.com' ||
         (request.auth.token.email != null && request.auth.token.email.matches('^aryanacharya.*@gmail[.]com$')));
    }
  }
}
