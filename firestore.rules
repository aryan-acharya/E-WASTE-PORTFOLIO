rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /assignments/{assignmentId} {
      // Anyone can view/read assignments
      allow read: if true;

      // Only the designated admin Google account is authorized to create, update, or delete
      allow create, update, delete: if request.auth != null && 
        request.auth.token.email == 'aryanacharya0211@gmail.com';
    }
  }
}
