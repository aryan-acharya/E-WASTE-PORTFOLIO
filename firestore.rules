rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /assignments/{assignmentId} {
      // Helper function to check if the caller is the verified admin Google account
      function isAdmin() {
        return request.auth != null &&
          request.auth.token.email_verified == true &&
          (request.auth.token.email == 'aryanacharya0211@gmail.com' ||
           request.auth.token.email == 'aryanacharya211@gmail.com' ||
           (request.auth.token.email != null && request.auth.token.email.matches('^aryanacharya.*@gmail[.]com$')));
      }

      // Public visitors can only read published assignments; Admin can read all (including drafts)
      allow read: if resource.data.isPublished == true || isAdmin();

      // ONLY the verified admin Google account can create, update, or delete assignments
      // All other users and anonymous visitors are strictly blocked at the database engine level
      allow create, update, delete: if isAdmin();
    }
  }
}
